{
  "name": "petibi",
  "version": "0.1.0",
  "private": true,
  "description": "Petibi —— MBTI 桌宠（Electron 透明悬浮窗原型，M1 工单）",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
