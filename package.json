{
  "name": "petibi",
  "version": "0.1.0",
  "private": true,
  "description": "Petibi —— MBTI 桌宠（Electron 透明悬浮窗原型，M1 工单）",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:server": "node scripts/build-server.mjs",
    "build:app": "electron-vite build",
    "build": "npm run typecheck && npm run build:server && electron-vite build && electron-builder",
    "pack:dir": "npm run build:server && electron-builder --dir",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.1"
  }
}