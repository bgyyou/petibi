# 【文件说明】环境变量示例：复制为 .env 后填入真实值；.env 不进仓库（.gitignore 已忽略）
# 与 server/config.ts 的 ServerConfig 字段一一对应；server/index.ts 启动时按 PETIBI_* 读取。

# 服务端监听（默认 8787 / 127.0.0.1）
PETIBI_PORT=8787
PETIBI_HOST=127.0.0.1

# SQLite 文件路径（默认 data/server.db；":memory:" 仅用于测试）
PETIBI_DB_PATH=data/server.db

# JWT 签名密钥（HS256）。生产务必改成强随机字符串，不要用 dev 默认值
PETIBI_JWT_SECRET=petibi-dev-secret-change-me

# JWT 过期秒数（默认 30 天）
PETIBI_JWT_EXPIRES=2592000

# 邮箱验证码过期秒数（默认 600 = 10 分钟；契约 §4）
PETIBI_CODE_EXPIRES=600

# 每日对话配额（默认 10；PRD §3.4 / REVIEW R4）
PETIBI_DAILY_QUOTA=10

# 运行模式：dev / prod / test（默认 dev）
PETIBI_ENV=dev

# --- M3 对话接口占位（M3 工单接管时启用；不在 M2 范围内） ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
